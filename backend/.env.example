# ==============================================================================
# ROADWATCH (Civic Bharat) - Backend Environment Configuration
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or local)
MONGO_URL=mongodb://localhost:27017
DB_NAME=roadwatch

# JWT Secret Key (generate a strong random string)
JWT_SECRET=change-this-to-a-secure-random-secret-key-32-bytes

# Administrator Account (auto-seeded on startup)
ADMIN_EMAIL=admin@roadwatch.dev
ADMIN_PASSWORD=admin123

# CORS Allowed Origins (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://civic-bharat-u6tw.onrender.com

# AI Vision Key (Claude Sonnet 5 via emergentintegrations)
# Optional: If omitted, system defaults to built-in heuristic road assessment
EMERGENT_LLM_KEY=

# Object Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
# Optional: If omitted, uploads are saved locally to backend/uploads/
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Public Base URL for generating full links to local assets
REACT_APP_BACKEND_URL=http://localhost:8000
